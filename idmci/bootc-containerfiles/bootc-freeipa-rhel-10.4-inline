# Self-contained FreeIPA bootc image for idm-ci
# Paste this into IDMCI_CUSTOM_CONTAINERFILE — no build context needed
# All scripts and systemd units are inlined via heredocs

FROM registry.redhat.io/rhel10/rhel-bootc:10.4

# FreeIPA server + DNS + trust + bootc infra
RUN dnf install -y \
    freeipa-server \
    freeipa-server-dns \
    freeipa-server-trust-ad \
    cloud-init \
    qemu-guest-agent \
    && dnf clean all

# bootc /usr → /var redirect for IPA HTML
RUN mkdir -p /var/lib/idm-image-mode /var/lib/ipa/html \
    && cp -a /usr/share/ipa/html/. /var/lib/ipa/html/ 2>/dev/null || true \
    && rm -rf /usr/share/ipa/html \
    && ln -s /var/lib/ipa/html /usr/share/ipa/html

# ── idm-firstboot script ───────────────────────────────────────────
RUN cat <<'FIRSTBOOT_EOF' > /usr/local/sbin/idm-firstboot
#!/bin/bash
# idm-firstboot — First boot provisioning for IdM Image Mode nodes
# Reads /etc/idm-image-mode/config.env, runs FreeIPA installer per IDM_ROLE

set -euo pipefail

CONFIG_FILE="/etc/idm-image-mode/config.env"
LOG_PREFIX="[idm-firstboot]"

log_info() { echo "${LOG_PREFIX} INFO: $*"; }
log_err()  { echo "${LOG_PREFIX} ERROR: $*" >&2; }
log_ok()   { echo "${LOG_PREFIX} OK: $*"; }

if [[ ! -f "$CONFIG_FILE" ]]; then
    log_err "Config file not found: $CONFIG_FILE"
    exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

required_vars=(IDM_ROLE IDM_DOMAIN IDM_REALM IDM_ADMIN_PASSWORD IDM_DS_PASSWORD)
for var in "${required_vars[@]}"; do
    if [[ -z "${!var:-}" ]]; then
        log_err "Required variable not set: $var"
        exit 1
    fi
done

log_info "Role: ${IDM_ROLE}"
log_info "Domain: ${IDM_DOMAIN}"
log_info "Realm: ${IDM_REALM}"

if [[ -n "${IDM_HOSTNAME:-}" ]]; then
    log_info "Setting hostname: ${IDM_HOSTNAME}"
    hostnamectl set-hostname "${IDM_HOSTNAME}" 2>/dev/null || hostname "${IDM_HOSTNAME}"
else
    IDM_HOSTNAME=$(hostname -f)
    log_info "Using system hostname: ${IDM_HOSTNAME}"
fi

CONTAINER_ARGS=(--no-ntp)

if systemctl is-active systemd-resolved &>/dev/null; then
    log_info "Disabling systemd-resolved (incompatible with IPA DNS)"
    systemctl stop systemd-resolved
    systemctl disable systemd-resolved
    rm -f /etc/resolv.conf
    echo "nameserver ${IDM_DNS_FORWARDER:-8.8.8.8}" > /etc/resolv.conf
fi

if [[ -n "${IDM_SERVER_IP:-}" && -n "${IDM_SERVER_FQDN:-}" ]]; then
    if ! grep -q "${IDM_SERVER_FQDN}" /etc/hosts 2>/dev/null; then
        log_info "Adding ${IDM_SERVER_FQDN} to /etc/hosts"
        echo "${IDM_SERVER_IP} ${IDM_SERVER_FQDN}" >> /etc/hosts
    fi
fi

case "$IDM_ROLE" in
    primary)
        log_info "Installing FreeIPA primary server..."

        install_args=(
            --domain="${IDM_DOMAIN}"
            --realm="${IDM_REALM}"
            --hostname="${IDM_HOSTNAME}"
            --ds-password="${IDM_DS_PASSWORD}"
            --admin-password="${IDM_ADMIN_PASSWORD}"
            --unattended
            "${CONTAINER_ARGS[@]}"
        )

        if [[ "${IDM_SETUP_DNS:-yes}" == "yes" ]]; then
            install_args+=(--setup-dns)
            if [[ -n "${IDM_DNS_FORWARDER:-}" ]]; then
                install_args+=(--forwarder="${IDM_DNS_FORWARDER}")
            else
                install_args+=(--no-forwarders)
            fi
            if [[ "${IDM_NO_REVERSE:-yes}" == "yes" ]]; then
                install_args+=(--no-reverse)
            fi
        fi

        if [[ "${IDM_SETUP_ADTRUST:-no}" == "yes" ]]; then
            install_args+=(--setup-adtrust)
        fi

        if [[ "${IDM_USE_THINCA:-no}" == "yes" ]]; then
            install_args+=(--use-ipathinca)
            log_info "Using IPAThinCA backend (no Dogtag/PKI)"
        fi

        ipa-server-install "${install_args[@]}"
        log_ok "FreeIPA primary server installed"
        ;;

    replica)
        log_info "Installing FreeIPA replica..."

        if [[ -z "${IDM_SERVER_FQDN:-}" ]]; then
            log_err "IDM_SERVER_FQDN required for replica role"
            exit 1
        fi

        log_info "Step 1/2: Enrolling as IPA client..."

        if [[ -n "${IDM_SERVER_IP:-}" ]]; then
            log_info "Setting DNS resolver to ${IDM_SERVER_IP}"
            echo "nameserver ${IDM_SERVER_IP}" > /etc/resolv.conf
        fi

        ipa-client-install \
            --server="${IDM_SERVER_FQDN}" \
            --domain="${IDM_DOMAIN}" \
            --realm="${IDM_REALM}" \
            --hostname="${IDM_HOSTNAME}" \
            --principal=admin \
            --password="${IDM_ADMIN_PASSWORD}" \
            --unattended \
            --force-join \
            "${CONTAINER_ARGS[@]}"

        log_info "Step 2/2: Promoting to replica..."

        replica_args=(
            --principal=admin
            --admin-password="${IDM_ADMIN_PASSWORD}"
            --unattended
        )

        if [[ "${IDM_REPLICA_SETUP_DNS:-yes}" == "yes" ]]; then
            replica_args+=(--setup-dns)
            if [[ -n "${IDM_DNS_FORWARDER:-}" ]]; then
                replica_args+=(--forwarder="${IDM_DNS_FORWARDER}")
            else
                replica_args+=(--no-forwarders)
            fi
        fi

        if [[ "${IDM_REPLICA_SETUP_CA:-yes}" == "yes" ]]; then
            replica_args+=(--setup-ca)
        fi

        if [[ "${IDM_USE_THINCA:-no}" == "yes" ]]; then
            replica_args+=(--use-ipathinca)
            log_info "Using IPAThinCA backend (no Dogtag/PKI)"
        fi

        if [[ "${IDM_SKIP_CONNCHECK:-no}" == "yes" ]]; then
            replica_args+=(--skip-conncheck)
            log_info "Skipping connection check (primary cannot reach this node)"
        fi

        ipa-replica-install "${replica_args[@]}"
        log_ok "FreeIPA replica installed"
        ;;

    client)
        log_info "Installing FreeIPA client..."

        if [[ -z "${IDM_SERVER_FQDN:-}" ]]; then
            log_err "IDM_SERVER_FQDN required for client role"
            exit 1
        fi

        if [[ -n "${IDM_SERVER_IP:-}" ]]; then
            log_info "Setting DNS resolver to ${IDM_SERVER_IP}"
            echo "nameserver ${IDM_SERVER_IP}" > /etc/resolv.conf
        fi

        ipa-client-install \
            --server="${IDM_SERVER_FQDN}" \
            --domain="${IDM_DOMAIN}" \
            --realm="${IDM_REALM}" \
            --hostname="${IDM_HOSTNAME}" \
            --principal=admin \
            --password="${IDM_ADMIN_PASSWORD}" \
            --unattended \
            --force-join \
            "${CONTAINER_ARGS[@]}"

        log_ok "FreeIPA client installed"
        ;;

    *)
        log_err "Unknown role: ${IDM_ROLE} (expected: primary, replica, client)"
        exit 1
        ;;
esac

log_ok "First boot provisioning complete (role=${IDM_ROLE})"
FIRSTBOOT_EOF

# ── idm-firstboot.service ──────────────────────────────────────────
RUN cat <<'FBSVC_EOF' > /etc/systemd/system/idm-firstboot.service
[Unit]
Description=IdM Image Mode First Boot Provisioning
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/idm-image-mode/.firstboot-complete
ConditionPathExists=/etc/idm-image-mode/config.env

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
ExecStartPre=/usr/bin/mkdir -p /var/lib/idm-image-mode
ExecStart=/usr/local/sbin/idm-firstboot
ExecStartPost=/usr/bin/touch /var/lib/idm-image-mode/.firstboot-complete
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
FBSVC_EOF

# ── idm-post-upgrade script ────────────────────────────────────────
RUN cat <<'UPGRADE_EOF' > /usr/local/sbin/idm-post-upgrade
#!/bin/bash
# idm-post-upgrade — detect image version change, run ipa-server-upgrade

set -euo pipefail

STAMP_FILE="/var/lib/idm-image-mode/.image-version"
BACKUP_BASE="/var/lib/idm-image-mode/backups"
CURRENT_VERSION=$(rpm -q freeipa-server 2>/dev/null || echo "unknown")

log() { logger -t idm-post-upgrade "$*"; echo "idm-post-upgrade: $*"; }

wait_for_ds() {
    local retries=12
    local delay=5
    local i
    for i in $(seq 1 "$retries"); do
        if ldapwhoami -Y EXTERNAL -H ldapi:/// 2>/dev/null; then
            return 0
        fi
        log "Waiting for 389-DS... ($i/$retries)"
        sleep "$delay"
    done
    log "ERROR: 389-DS not responding after $((retries * delay))s"
    return 1
}

if [[ -f "$STAMP_FILE" ]]; then
    PREV_VERSION=$(cat "$STAMP_FILE")
    if [[ "$CURRENT_VERSION" != "$PREV_VERSION" ]]; then
        log "Image version changed: $PREV_VERSION -> $CURRENT_VERSION"

        BACKUP_DIR="$BACKUP_BASE/$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$BACKUP_DIR"
        cp /var/lib/ipa/sysupgrade/sysupgrade.state "$BACKUP_DIR/" 2>/dev/null || true
        ldapsearch -Y EXTERNAL -H ldapi:/// \
            -b "cn=schema" -s base objectClasses attributeTypes \
            > "$BACKUP_DIR/schema-before.ldif" 2>/dev/null || true

        wait_for_ds || exit 1

        log "Running ipa-server-upgrade"
        if ipa-server-upgrade; then
            echo "$CURRENT_VERSION" > "$STAMP_FILE"
            log "Upgrade successful"
        else
            log "Upgrade FAILED (rc=$?) — rollback may be needed"
            exit 1
        fi
    else
        log "Version unchanged ($CURRENT_VERSION), nothing to do"
    fi
else
    log "First boot stamp: $CURRENT_VERSION"
    echo "$CURRENT_VERSION" > "$STAMP_FILE"
fi
UPGRADE_EOF

# ── idm-post-upgrade.service ───────────────────────────────────────
RUN cat <<'UPSVC_EOF' > /etc/systemd/system/idm-post-upgrade.service
[Unit]
Description=IdM Image Mode Post-Upgrade Check
After=dirsrv.target ipa.service
ConditionPathExists=/var/lib/idm-image-mode/.firstboot-complete

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/sbin/idm-post-upgrade
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
UPSVC_EOF

# ── Permissions + Enable ───────────────────────────────────────────
RUN chmod 755 /usr/local/sbin/idm-firstboot /usr/local/sbin/idm-post-upgrade \
    && systemctl enable idm-firstboot.service idm-post-upgrade.service \
                        cloud-init.service qemu-guest-agent.service
