# idm-image-mode deployment configuration
# Copy to config.env and edit before deploying:
#   cp config/config.env.example config.env

# ── Role ─────────────────────────────────────────────────────────────
# Which type of IdM node to deploy
IDM_ROLE=primary           # primary | replica | client

# ── Domain ───────────────────────────────────────────────────────────
IDM_DOMAIN=test.example.com
IDM_REALM=TEST.EXAMPLE.COM

# ── Credentials ──────────────────────────────────────────────────────
IDM_ADMIN_PASSWORD=Secret123!
IDM_DS_PASSWORD=Secret123!

# ── Network ──────────────────────────────────────────────────────────
# Hostname for this node (auto-detected from system hostname if empty)
IDM_HOSTNAME=

# ── Primary Server Options ───────────────────────────────────────────
IDM_SETUP_DNS=yes
IDM_DNS_FORWARDER=8.8.8.8
IDM_NO_REVERSE=yes
IDM_SETUP_ADTRUST=no

# ── Replica / Client Options ────────────────────────────────────────
# FQDN and IP of the primary server to enroll against
IDM_SERVER_FQDN=idm1.test.example.com
IDM_SERVER_IP=192.168.140.101

# ── Replica-Specific ────────────────────────────────────────────────
IDM_REPLICA_SETUP_DNS=yes
IDM_REPLICA_SETUP_CA=yes
IDM_SKIP_CONNCHECK=no

# ── CA Backend ──────────────────────────────────────────────────────
# Use IPAThinCA instead of Dogtag/PKI (requires python3-ipathinca)
# Lighter footprint, faster install, no Java/Tomcat
IDM_USE_THINCA=no

# ── OAuth2 / ahdapa (optional, requires -oauth2 image layer) ───────
# Register an OIDC client at first boot. Leave empty to skip.
#AHDAPA_CLIENT_ID=arbiter-hub
#AHDAPA_CLIENT_SECRET=
#AHDAPA_CLIENT_NAME=Arbiter Hub API
#AHDAPA_REDIRECT_URI=https://hub.example.com/auth/callback
#AHDAPA_SCOPES=["openid", "profile"]

# ── SPIFFE Federation (optional) ───────────────────────────────────
# Enable SPIFFE→IPA federation token exchange. Requires ahdapa.
# Sets up [federation] in ahdapa.toml, Identity HBAC rule,
# and token exchange audiences on the registered client.
#SPIFFE_TRUST_DOMAIN=arbiter.demo
